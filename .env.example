# Copy this file to .env and fill it in.

# REQUIRED: password for the admin panel. Use something long.
ADMIN_PASSWORD=change-me-to-something-long

# Leave empty when the radio has its own subdomain (radio.yourdomain.com).
# Set it when the radio lives in a subfolder of another site, e.g. yourdomain.com/radio:
# BASE_PATH=/radio
BASE_PATH=

# Where the admin panel lives. Changing it to something unguessable keeps bots off the login page.
ADMIN_PATH=admin

# The app only listens on localhost by default; your web server proxies to it.
HOST=127.0.0.1
PORT=8090

# Set to true once the site is served over HTTPS (it should be).
SECURE_COOKIES=false

# Which proxy addresses to trust for the real visitor IP (used for rate limits).
# "loopback" is right when nginx/Apache runs on the same machine.
TRUST_PROXY=loopback

# Stream quality. All songs are converted to this CBR MP3 bitrate on upload.
STREAM_BITRATE=192
# Even out loudness between songs (EBU R128, -14 LUFS).
LOUDNORM=true

MAX_UPLOAD_MB=300
# Simultaneous stream connections allowed from one IP.
MAX_STREAMS_PER_IP=4

# Pages allowed to embed the radio in an iframe (space separated). Example: self https://yourmainsite.com
FRAME_ANCESTORS=self

# Only needed if ffmpeg is not on PATH (e.g. Windows): full paths to the binaries.
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# Where songs, covers and the library live. Keep it OUTSIDE any public web folder.
DATA_DIR=data
